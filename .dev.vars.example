# Copia este archivo a `.dev.vars` para desarrollo local (wrangler lo lee solo).
# En producción, las mismas variables van en Cloudflare Pages →
# Settings → Environment variables. .dev.vars está en .gitignore: la llave
# privada NUNCA entra al repo.

GOOGLE_SERVICE_ACCOUNT_EMAIL="didakus@adcformatos.iam.gserviceaccount.com"
# Pega el campo private_key del service-account.json, con los \n tal cual.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

SHEET_ID="1z0Wcc2-A0S6JCVjm_e3kfcXZgZMgr3g_VpOTMq6X3IU"

# Dominio exigido en el correo del inspector. VACÍO = se acepta cualquiera.
# Está vacío a propósito: el personal está repartido entre correo corporativo
# y personal, y exigir un dominio dejaría a media plantilla sin poder
# registrar su constancia. Se puede volver a activar cuando todos migren.
DOMINIO_CORPORATIVO=""

# Copia oculta de cada constancia. Opcional.
CORREO_CALIDAD=""

# --- Correo -----------------------------------------------------------------
# Buzón desde el que salen los correos. Vacío = no se manda nada (el registro
# igual se guarda).
GMAIL_REMITENTE=""

# Vía B (OAuth de usuario): sirve con cuentas @gmail.com. Se obtiene una vez con
#   python scripts/autorizar_gmail.py ruta/al/drive-oauth-client.json
# Si están las tres, se usa esta vía en vez de la delegación de dominio.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# Firma dibujada además de la casilla de aceptación.
EXIGE_FIRMA="false"
CARPETA_FIRMAS_ID=""

# Listado Maestro de Calidad: de aquí sale el catálogo de aplicaciones, tanto
# para elegir capacitación como para el buzón. SOLO LECTURA.
# Si se dejan vacías se usan estos mismos valores por defecto (están en el
# código); solo hay que tocarlas si el Sheet se mueve.
# Ojo: el nombre de la hoja termina en espacio.
LISTADO_MAESTRO_ID="1NH4KKN1_zJ7mqluN5h0TncbiLh6wAiYOU9yNKLiA9uA"
LISTADO_MAESTRO_HOJA="Listado Maestro "

# Quien dicta la capacitacion. Va en la constancia (campo del F-SIG-19).
EXPOSITOR="Diego Alejandro Hernandez Blanco"
